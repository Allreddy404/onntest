def make_dev(RIN_dBc=-150, ERIN_dBc=-150, R_resp=0.95,
             R_L=200.0, I_d=30e-9, T=300.0):
    return dict(
        RIN    = 10**(RIN_dBc  / 10),
        ERIN   = 10**(ERIN_dBc / 10),
        R_resp = R_resp,
        R_L    = R_L,
        I_d    = I_d,
        T      = T,
    )

DEV_DISPLAY = make_dev(R_L=200.0)   # all three regimes visible
DEV_HSPD    = make_dev(R_L=50.0)    # high-speed TIA

# ══════════════════════════════════════════════════════════════════[...]
#  Core model
# ══════════════════════════════════════════════════════════════════[...]

def coeffs(rho, P_max, dev):
    """Return (C_eta, C_coh, C_shot, C_bg) in Hz⁻¹."""
    R, D = dev['R_resp'], dev
    C_eta  = (1.0 - rho) * D['RIN'] + D['ERIN']
    C_coh  = rho * D['RIN']
    C_shot = 2.0 * q / (R * P_max)
    C_bg   = (4.0*kB*D['T']/D['R_L'] + 2.0*q*D['I_d']) / (R * P_max)**2
    return C_eta, C_coh, C_shot, C_bg


def sigma_sq(eta, rho, B, P_max, dev):
    Ce, Cc, Cs, Cb = coeffs(rho, P_max, dev)
    return (Ce*eta + Cc + Cs + Cb) * B


def crossover_powers(rho, eta, dev):
    """
    Analytically derived regime boundaries.
    Returns (P_th_sh, P_sh_comp) in Watts.
    P_th_sh  : thermal → shot crossover  (C_bg = C_shot)
    P_sh_comp: shot → computation crossover (C_shot = C_eta*eta + C_coh)
    """
    R = dev['R_resp']
    thermal_psd = 4.0*kB*dev['T']/dev['R_L'] + 2.0*q*dev['I_d']
    P_th_sh   = thermal_psd / (2.0 * q * R)
    C_comp    = (1.0 - rho)*dev['RIN']*eta + dev['ERIN']*eta + rho*dev['RIN']
    P_sh_comp = 2.0 * q / (R * C_comp)
    return P_th_sh, P_sh_comp

