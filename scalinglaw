#  Helper: secondary ENOB axis
# ══════════════════════════════════════════════════════════════════[...]

def _add_enob_axis(ax):
    """
    Add a right y-axis showing CC-ENOB (k=1) corresponding to σ²/B
    values on the left axis.  Because ENOB = −½ log₂(σ²) and the
    left axis is log-scaled, the right axis ticks are placed manually.
    """
    ax2 = ax.twinx()
    ax2.set_yscale('log')

    # Mirror the same y-limits and scale
    ylo, yhi = ax.get_ylim()
    ax2.set_ylim(ylo, yhi)

    # Choose representative ENOB tick values
    enob_ticks = np.array([4, 6, 8, 10, 12, 14])
    # σ² = 2^{-2·ENOB}  (at k=1, B=1 Hz → σ²/B = σ²_coeff)
    sigma_for_enob = 2.0**(-2.0 * enob_ticks)

    # Only show ticks within current y range
    mask = (sigma_for_enob >= ylo) & (sigma_for_enob <= yhi)
    ax2.set_yticks(sigma_for_enob[mask])
    ax2.set_yticklabels([str(e) for e in enob_ticks[mask]], fontsize=7.5)
    ax2.set_ylabel(r'ENOB ($k=1$) [bits]', fontsize=8.5)


