#  STEP 1 — Universal B-linear scaling
# ══════════════════════════════════════════════════════════════════[...]

def fig_step1_bandwidth_scaling(dev=DEV_DISPLAY, save=True):
    """
    σ²_norm vs B for different (ρ, P_max) combinations.
    All lines are parallel with slope = 1 on the log–log plot,
    demonstrating that B is the universal, architecture-independent
    precision cost.
    Left panel : total σ²_norm for four architecture × power scenarios.
    Right panel: individual noise components at P_max = 1 mW, ρ = 0,
                 showing every term scales identically with B.
    """
    B_arr = np.logspace(4, 12, 800)
    eta0  = 0.20

    # ── scenarios for left panel ──
    scenarios_L = [
        dict(rho=0.0, P_max=1e-3,   col=BLUE,   ls='-',
             lbl=r'$\rho=0$,  $P_{\max}=1\,\mathrm{mW}$'),
        dict(rho=1.0, P_max=1e-3,   col=RED,    ls='-',
             lbl=r'$\rho=1$,  $P_{\max}=1\,\mathrm{mW}$'),
        dict(rho=0.0, P_max=1e-2, col=BLUE,   ls='--',
             lbl=r'$\rho=0$,  $P_{\max}=10\,\mathrm{mW}$'),
        dict(rho=1.0, P_max=1e-2, col=RED,    ls='--',
             lbl=r'$\rho=1$,  $P_{\max}=10\,\mathrm{mW}$'),
    ]

    fig, (ax_l, ax_r) = plt.subplots(1, 2, figsize=(9.5, 4.0))

    # ─── Left panel: total σ² for four scenarios ───
    for sc in scenarios_L:
        y = sigma_sq(eta0, sc['rho'], B_arr, sc['P_max'], dev)
        ax_l.loglog(B_arr, y, color=sc['col'], ls=sc['ls'], label=sc['lbl'])

    # Reference ∝B guide line
    B_ref = np.array([3e5, 3e10])
    ref_y = 3e-12 * (B_ref / 1e6)
    ax_l.loglog(B_ref, ref_y, 'k:', lw=1.1,
                label=r'$\propto\!B$ guide (slope$\,=1$)')

    # Slope annotation with bracket
    ax_l.annotate('',
        xy=(3e10, 3e-2), xytext=(3e9, 3e-3),
        arrowprops=dict(arrowstyle='->', color='k', lw=0.9))
    ax_l.text(5.5e9, 6e-3, r'slope $=1$', fontsize=8.5, rotation=43)

    ax_l.set_xlabel(r'Operational bandwidth $B$ (Hz)')
    ax_l.set_ylabel(r'Normalized variance $\sigma^2_{\rm norm}$')
    ax_l.set_title(r'(a) Universal $\sigma^2_{\rm norm}\propto B$ '
                   r'across architectures')
    ax_l.legend(loc='upper left', fontsize=7.5)
    ax_l.set_xlim(1e4, 1e12)
    ax_l.grid(True, which='major', ls=':', alpha=0.40)
    ax_l.grid(True, which='minor', ls=':', alpha=0.15)

    # ─── Right panel: component breakdown at P=1 mW, ρ=0 ───
    P_fix  = 1e-3
    rho_fix = 0.0
    Ce, Cc, Cs, Cb = coeffs(rho_fix, P_fix, dev)

    components = [
        (Ce*eta0 * B_arr, PURPLE, '-',  r'$C_\eta\eta\cdot B$ (computation)'),
        (Cb      * B_arr, GRAY,   '--', r'$C_{\rm bg}\cdot B$ (thermal)'),
        (Cs      * B_arr, GREEN,  '--', r'$C_{\rm shot}\cdot B$ (shot)'),
        (sigma_sq(eta0, rho_fix, B_arr, P_fix, dev), 'k', '-',
         r'Total $\sigma^2_{\rm norm}$'),
    ]
    for y, col, ls, lbl in components:
        ax_r.loglog(B_arr, y, color=col, ls=ls, lw=1.5, label=lbl)

    # Annotate that ALL components are parallel
    ax_r.text(0.55, 0.22,
              'All components:\nslope $= 1$\n(identical $B$-dependence)',
              transform=ax_r.transAxes, fontsize=8, ha='center',
              bbox=dict(boxstyle='round,pad=0.35', fc='white', ec='0.7', lw=0.7))

    ax_r.set_xlabel(r'Operational bandwidth $B$ (Hz)')
    ax_r.set_ylabel(r'Noise contribution to $\sigma^2_{\rm norm}$')
    ax_r.set_title(r'(b) Individual noise terms vs $B$ '
                   r'($P_{\max}=1\,\mathrm{mW}$, $\rho=0$)')
    ax_r.legend(loc='upper left', fontsize=7.5)
    ax_r.set_xlim(1e4, 1e12)
    ax_r.grid(True, which='major', ls=':', alpha=0.40)
    ax_r.grid(True, which='minor', ls=':', alpha=0.15)

    fig.tight_layout(pad=1.5, w_pad=2.5)
    if save:
        outpath1 = os.path.join(OUTPUT_DIR, "fig_step1_bandwidth.pdf")
        outpath2 = os.path.join(OUTPUT_DIR, "fig_step1_bandwidth.png")
        fig.savefig(outpath1)
        fig.savefig(outpath2, dpi=200)
        print('✓  fig_step1_bandwidth saved')
    return fig


# ══════════════════════════════════════════════════════════════════[...]
#  STEP 2 — P_max sweep: three regime transitions
# ══════════════════════════════════════════════════════════════════[...]

def fig_step2_power_sweep(dev=DEV_DISPLAY, save=True):
    """
    Left panel:  σ²_norm vs P_max for ρ=0 and ρ=1.
                 Three regimes annotated:
                   • Low P  — background-noise limited, slope −2
                   • Mid P  — shot-noise limited, slope −1
                   • High P — computation-noise limited, slope 0 (flat)
                 Analytical crossover powers P*_th→sh and P*_sh→comp
                 are marked by dashed vertical lines.

    Right panel: Stacked noise-budget bars at three operating points
                 (one per regime), showing comparison between ρ=0 and ρ=1.
                 Total 6 columns: 3 for ρ=0, 3 for ρ=1.
    """
    B0   = 1e9       # 1 GHz reference
    eta0 = 0.20
    P_arr = np.logspace(-4, 4, 800) * 1e-3   # 10 nW → 10 mW

    # Analytical crossover powers
    P_th_sh_0,  P_sh_comp_0  = crossover_powers(0.0, eta0, dev)
    P_th_sh_1,  P_sh_comp_1  = crossover_powers(1.0, eta0, dev)

    fig, (ax_l, ax_r) = plt.subplots(1, 2, figsize=(12.0, 4.4))

    # ─── Left panel: σ² vs P_max ───
    for rho, col, lbl in [(0.0, BLUE, r'$\rho=0$ (independent sources)'),
                          (1.0, RED,  r'$\rho=1$ (shared source)')]:
        y = np.array([sigma_sq(eta0, rho, B0, P, dev) for P in P_arr])
        ax_l.loglog(P_arr*1e3, y, color=col, lw=1.8, label=lbl)

    # Individual noise components for ρ=0 (dashed)
    comp_lines = []
    for P in P_arr:
        Ce, Cc, Cs, Cb = coeffs(0.0, P, dev)
        comp_lines.append((Ce*eta0*B0, Cb*B0, Cs*B0))
    comp_lines = np.array(comp_lines)
    P_mW = P_arr * 1e3
    ax_l.loglog(P_mW, comp_lines[:,2], color=GREEN,  lw=0.9, ls=':',
                label=r'$C_{\rm shot}\cdot B$')
    ax_l.loglog(P_mW, comp_lines[:,1], color=GRAY,   lw=0.9, ls=':',
                label=r'$C_{\rm bg}\cdot B$')
    ax_l.loglog(P_mW, comp_lines[:,0], color=PURPLE, lw=0.9, ls=':',
                label=r'$C_\eta\eta\cdot B$')

    # Regime shading (background)
    ylo, yhi = 5e-16, 1.0
    ax_l.set_ylim(ylo, yhi)
    P_lo, P_hi = P_arr[0]*1e3, P_arr[-1]*1e3

    ax_l.axvspan(P_lo,              P_th_sh_0*1e3, alpha=0.06,
                 color=GRAY,   zorder=0, label='_')
    ax_l.axvspan(P_th_sh_0*1e3,    P_sh_comp_0*1e3, alpha=0.06,
                 color=GREEN,  zorder=0, label='_')
    ax_l.axvspan(P_sh_comp_0*1e3,  P_hi,          alpha=0.06,
                 color=PURPLE, zorder=0, label='_')

    # Crossover vertical lines
    for P_x, col, lbl in [
        (P_th_sh_0,   GRAY,   r'$P^*_{\rm th{\to}sh}$'),
        (P_sh_comp_0, PURPLE, r'$P^*_{\rm sh{\to}comp}$'),
    ]:
        ax_l.axvline(P_x*1e3, color=col, lw=1.0, ls='--', alpha=0.7)
        ax_l.text(P_x*1e3*1.18, ylo*8, lbl, fontsize=8,
                  color=col, ha='left', rotation=90, va='bottom')

    # Slope annotation arrows + labels
    def slope_arrow(ax, P1, P2, y1, y2, txt, col, rot):
        ax.annotate('', xy=(P2, y2), xytext=(P1, y1),
                    arrowprops=dict(arrowstyle='->', color=col, lw=0.9))
        ax.text((P1*P2)**0.5, (y1*y2)**0.5 * 1.8, txt,
                fontsize=8, color=col, rotation=rot, ha='center')

    slope_arrow(ax_l, 0.015, 0.04, 1e-10, 1e-12,
                r'slope $= -2$', GRAY,   -55)
    slope_arrow(ax_l, 0.12,  0.4,  5e-10, 5e-11,
                r'slope $= -1$', GREEN,  -25)

    # Flat / saturation annotation
    ax_l.text(3.0, 2e-8, r'slope $= 0$' + '\n' + r'(saturated)',
              fontsize=8, color=PURPLE, ha='center')

    ax_l.set_xlabel(r'Full-scale optical power $P_{\max}$ (mW)')
    ax_l.set_ylabel(r'$\sigma^2_{\rm norm}$ at $B = 1\,\mathrm{GHz}$')
    ax_l.set_title(r'(a) Precision vs $P_{\max}$: three noise-dominated regimes')
    ax_l.set_xlim(P_lo, P_hi)
    ax_l.legend(loc='lower left', fontsize=7.2, ncol=1)
    ax_l.grid(True, which='major', ls=':', alpha=0.40)
    ax_l.grid(True, which='minor', ls=':', alpha=0.15)

    # ─── Right panel: noise budget at three operating points ───
    # Compute for ρ=0: three representative powers
    P_ops_W_rho0 = np.array([
        P_th_sh_0  / 6.0,              # deep thermal regime
        (P_th_sh_0 * P_sh_comp_0)**0.5, # geometric mean → shot regime
        P_sh_comp_0 * 6.0,              # deep computation regime
    ])
    
    # Compute for ρ=1: three representative powers based on ρ=1 crossovers
    P_ops_W_rho1 = np.array([
        P_th_sh_1  / 6.0,              # deep thermal regime
        (P_th_sh_1 * P_sh_comp_1)**0.5, # geometric mean → shot regime
        P_sh_comp_1 * 6.0,              # deep computation regime
    ])

    labels_op = [
        r'Thermal',
        r'Shot',
        r'Computation',
    ]

    # Compute noise fractions for ρ=0
    frac_bg_r0, frac_shot_r0, frac_eta_r0, frac_coh_r0 = [], [], [], []
    for P in P_ops_W_rho0:
        Ce, Cc, Cs, Cb = coeffs(0.0, P, dev)
        tot = (Ce*eta0 + Cc + Cs + Cb)
        frac_bg_r0.append(Cb / tot)
        frac_shot_r0.append(Cs / tot)
        frac_eta_r0.append(Ce*eta0 / tot)
        frac_coh_r0.append(Cc / tot)

    # Compute noise fractions for ρ=1
    frac_bg_r1, frac_shot_r1, frac_eta_r1, frac_coh_r1 = [], [], [], []
    for P in P_ops_W_rho1:
        Ce, Cc, Cs, Cb = coeffs(1.0, P, dev)
        tot = (Ce*eta0 + Cc + Cs + Cb)
        frac_bg_r1.append(Cb / tot)
        frac_shot_r1.append(Cs / tot)
        frac_eta_r1.append(Ce*eta0 / tot)
        frac_coh_r1.append(Cc / tot)

    # Create bar positions: 3 groups for ρ=0, 3 groups for ρ=1 with separator
    x_rho0 = np.arange(3)
    x_rho1 = np.arange(3) + 4  # offset by 4, creating gap at 3-3.5
    x_all = np.concatenate([x_rho0, x_rho1])

    # Prepare data arrays for stacking
    btm_r0 = np.zeros(3)
    btm_r1 = np.zeros(3)

    budget_items = [
        (np.array(frac_bg_r0),   np.array(frac_bg_r1),   GRAY,   r'$C_{\rm bg}\cdot B$ (thermal)'),
        (np.array(frac_shot_r0), np.array(frac_shot_r1), GREEN,  r'$C_{\rm shot}\cdot B$ (shot)'),
        (np.array(frac_eta_r0),  np.array(frac_eta_r1),  PURPLE, r'$C_\eta\eta\cdot B$ (computation)'),
        (np.array(frac_coh_r0),  np.array(frac_coh_r1),  RED,    r'$C_{\rm coh}\cdot B$ (coherent)'),
    ]

    for vals_r0, vals_r1, col, lbl in budget_items:
        ax_r.bar(x_rho0, vals_r0, bottom=btm_r0, color=col, label=lbl,
                 edgecolor='white', linewidth=0.6, width=0.5, alpha=0.9)
        ax_r.bar(x_rho1, vals_r1, bottom=btm_r1, color=col,
                 edgecolor='white', linewidth=0.6, width=0.5, alpha=0.6)
        btm_r0 += vals_r0
        btm_r1 += vals_r1

    # X-axis labels
    xticklabels = []
    
    # Labels for ρ=0
    for i, (P, lbl) in enumerate(zip(P_ops_W_rho0, labels_op)):
        P_mW_val = P * 1e3
        if P_mW_val < 0.01:
            p_str = f'{P_mW_val*1e3:.1f} μW'
        else:
            p_str = f'{P_mW_val:.3f} mW'
        xticklabels.append(f'{lbl}\n({p_str})')
    
    # Gap for x=3 (no label)
    # Labels for ρ=1
    for i, (P, lbl) in enumerate(zip(P_ops_W_rho1, labels_op)):
        P_mW_val = P * 1e3
        if P_mW_val < 0.01:
            p_str = f'{P_mW_val*1e3:.1f} μW'
        else:
            p_str = f'{P_mW_val:.3f} mW'
        xticklabels.append(f'{lbl}\n({p_str})')

    # Set ticks and labels (skip x=3)
    ax_r.set_xticks(np.concatenate([x_rho0, x_rho1]))
    ax_r.set_xticklabels(xticklabels, fontsize=7.0)

    # Add group labels for ρ=0 and ρ=1 in figure coordinates
    ax_r.text(1.0, -0.36, r'$\rho=0$ (independent)', 
              transform=ax_r.transAxes, ha='center', fontsize=9, 
              fontweight='bold', color=BLUE)
    ax_r.text(0.65, -0.36, r'$\rho=1$ (shared)', 
              transform=ax_r.transAxes, ha='center', fontsize=9, 
              fontweight='bold', color=RED)

    ax_r.yaxis.set_major_formatter(
        mticker.FuncFormatter(lambda v, _: f'{v*100:.0f}%'))
    ax_r.set_ylabel(r'Fraction of total $\sigma^2_{\rm norm}$')
    ax_r.set_title(r'(b) Noise budget: $\rho$-dependence ($B=1\,\mathrm{GHz}$)')
    ax_r.set_ylim(0, 1.15)
    ax_r.set_xlim(-0.5, 7.5)
    ax_r.legend(loc='upper right', fontsize=7.2)
    ax_r.grid(True, axis='y', ls=':', alpha=0.40)

    # Add a visual separator line between ρ=0 and ρ=1 sections
    ax_r.axvline(3.5, color='0.7', lw=1.2, ls='--', alpha=0.6)

    fig.tight_layout(pad=1.5, w_pad=2.5)
    if save:
        outpath1 = os.path.join(OUTPUT_DIR, "fig_step2_power_sweep.pdf")
        outpath2 = os.path.join(OUTPUT_DIR, "fig_step2_power_sweep.png")
        fig.savefig(outpath1)
        fig.savefig(outpath2, dpi=200)
        print('✓  fig_step2_power_sweep saved')
    return fig


# ══════════════════════════════════════════════════════════════════[...]
#  STEP 3 — Incoherent averaging in the computation-limited regime
# ══════════════════════════════════════════════════════════════════[...]

def fig_step3_averaging(dev=DEV_DISPLAY, save=True):
    """
    Three-panel figure evaluated at P_high (well in the computation-
    limited, saturated regime).  Shows σ²_norm/B vs η.

    Panel (a): ρ=0, N ∈ {4,16,64,256}
               As N grows, the dense-limit minimum σ² decreases as 1/N.
    Panel (b): ρ=1, N ∈ {4,16,64,256}
               All curves converge to the C_coh floor; N is irrelevant.
    Panel (c): N=64, ρ ∈ {0, 0.25, 0.5, 1.0}
               All curves converge at η=1 (ρ-independent ceiling).
               The averaging benefit of low ρ emerges only at small η.
    """
    # Choose P_high well above both crossovers
    _, P_sh_comp = crossover_powers(0.0, 0.20, dev)
    P_high = P_sh_comp * 8.0      # 8× above computation crossover
    B_ref  = 1e9                  # reference; y-axis is σ²/B = coeff sum

    N_vals   = [4, 16, 64, 256]
    rho_vals = [0.0, 0.25, 0.5, 1.0]

    eta_dense = np.linspace(0.001, 1.0, 1200)

    def sigma_per_B(eta, rho, P=P_high):
        """σ²_norm / B = sum of four coefficients × eta."""
        Ce, Cc, Cs, Cb = coeffs(rho, P, dev)
        return Ce*eta + Cc + Cs + Cb

    fig, axes = plt.subplots(1, 3, figsize=(12.0, 4.2))

    # ── compute reference floor values ──
    _, Cc_floor_r0, Cs_floor, Cb_floor = coeffs(0.0, P_high, dev)
    Ce_r1, Cc_floor_r1, _, _ = coeffs(1.0, P_high, dev)
    total_max_floor = dev['RIN'] + dev['ERIN'] + Cs_floor + Cb_floor

    # ── Panel (a): ρ=0, varying N ──
    ax = axes[0]
    for N, col in zip(N_vals, N_COLORS):
        eta_min = 1.0 / N
        mask    = eta_dense >= eta_min - 1e-4
        y = sigma_per_B(eta_dense[mask], 0.0)
        ax.semilogy(eta_dense[mask], y, color=col, lw=1.7, label=f'$N={N}$')
        # Mark dense-limit point
        y0 = sigma_per_B(eta_min, 0.0)
        ax.plot(eta_min, y0, 'o', color=col, ms=5.5, zorder=5,
                markeredgecolor='white', markeredgewidth=0.5)
        ax.axvline(eta_min, color=col, lw=0.55, ls=':', alpha=0.4)

    # Annotate: averaging benefit
    ax.annotate(
        r'Dense limit $\eta=N^{-1}$:' + '\n' + r'$\sigma^2\propto N^{-1}$',
        xy=(1/16, sigma_per_B(1/16, 0.0)),
        xytext=(0.12, sigma_per_B(1/16, 0.0)*0.15),
        fontsize=7.5,
        arrowprops=dict(arrowstyle='->', lw=0.8, color='0.4'),
        ha='left')

    # ENOB secondary axis
    _add_enob_axis(ax)

    ax.set_xlabel(r'Data sparsity index $\eta$')
    ax.set_ylabel(r'$\sigma^2_{\rm norm}/B\;[\mathrm{Hz}^{-1}]$')
    ax.set_title(r'(a) $\rho=0$ — independent sources')
    ax.set_xlim(-0.02, 1.02)
    ax.legend(fontsize=8, loc='upper left')
    ax.grid(True, which='major', ls=':', alpha=0.38)

    # ── Panel (b): ρ=1, varying N ──
    ax = axes[1]
    C_coh_val = dev['RIN']   # = ρ·RIN at ρ=1
    floor_val = sigma_per_B(0.0, 1.0)   # η→0 limit (= C_coh+C_shot+C_bg)

    for N, col in zip(N_vals, N_COLORS):
        eta_min = 1.0 / N
        mask    = eta_dense >= eta_min - 1e-4
        y = sigma_per_B(eta_dense[mask], 1.0)
        ax.semilogy(eta_dense[mask], y, color=col, lw=1.7, label=f'$N={N}$')
        y0 = sigma_per_B(eta_min, 1.0)
        ax.plot(eta_min, y0, 'o', color=col, ms=5.5, zorder=5,
                markeredgecolor='white', markeredgewidth=0.5)

    # C_coh floor line
    ax.axhline(floor_val, color='k', lw=1.1, ls='--', alpha=0.65,
               label=r'$C_{\rm coh}$ floor')
    ax.text(0.50, floor_val * 1.35, r'$C_{\rm coh}$ floor (N-independent)',
            ha='center', fontsize=8.0, color='k')

    _add_enob_axis(ax)

    ax.set_xlabel(r'Data sparsity index $\eta$')
    ax.set_ylabel(r'$\sigma^2_{\rm norm}/B\;[\mathrm{Hz}^{-1}]$')
    ax.set_title(r'(b) $\rho=1$ — shared source')
    ax.set_xlim(-0.02, 1.02)
    ax.legend(fontsize=8, loc='upper left')
    ax.grid(True, which='major', ls=':', alpha=0.38)

    # ── Panel (c): N=64, varying ρ ──
    ax = axes[2]
    N_c     = 64
    eta_min_c = 1.0 / N_c
    mask_c  = eta_dense >= eta_min_c - 1e-4

    for rho_c, col in zip(rho_vals, RHO_COLORS):
        y = sigma_per_B(eta_dense[mask_c], rho_c)
        ax.semilogy(eta_dense[mask_c], y, color=col, lw=1.7,
                    label=rf'$\rho={rho_c}$')

    # Dense-limit markers
    for rho_c, col in zip(rho_vals, RHO_COLORS):
        y0 = sigma_per_B(eta_min_c, rho_c)
        ax.plot(eta_min_c, y0, 'o', color=col, ms=5.5, zorder=5,
                markeredgecolor='white', markeredgewidth=0.5)

    # Convergence at η=1: all curves meet at RIN+ERIN+...
    y_conv = sigma_per_B(1.0, 0.0)    # same for all ρ (see Remark in paper)
    ax.axhline(y_conv, color='k', lw=0.9, ls=':', alpha=0.55)

    # Dense-limit vertical guide
    ax.axvline(eta_min_c, color='0.5', lw=0.9, ls='--', alpha=0.5)
    ax.text(eta_min_c + 0.015, sigma_per_B(eta_min_c, 0.5)*0.35,
            r'$\eta_{\min}=N^{-1}$', fontsize=8, color='0.45',
            ha='left', rotation=90)

    # ENOB difference annotation between ρ=0 and ρ=1 at eta_min_c
    y_rho0 = sigma_per_B(eta_min_c, 0.0)
    y_rho1 = sigma_per_B(eta_min_c, 1.0)
    delta_enob = 0.5 * np.log2(y_rho1 / y_rho0)
    ax.annotate('',
        xy=(eta_min_c - 0.005, y_rho0),
        xytext=(eta_min_c - 0.005, y_rho1),
        arrowprops=dict(arrowstyle='<->', color=ORANGE,
                        lw=1.1, mutation_scale=10))
    ax.text(eta_min_c - 0.055,
            (y_rho0 * y_rho1)**0.5,
            f'$\\Delta$ENOB\n'
            rf'$={delta_enob:.1f}$ bits'
            '\n'
            rf'$\approx\frac{{1}}{{2}}\log_2 N$',
            fontsize=7.5, color=ORANGE, ha='right', va='center')

    _add_enob_axis(ax)

    ax.set_xlabel(r'Data sparsity index $\eta$')
    ax.set_ylabel(r'$\sigma^2_{\rm norm}/B\;[\mathrm{Hz}^{-1}]$')
    ax.set_title(r'(c) $N=64$ — varying source correlation $\rho$')
    ax.set_xlim(-0.02, 1.02)
    ax.legend(fontsize=8, loc='upper left')
    ax.grid(True, which='major', ls=':', alpha=0.38)

    # ── shared y-limits across panels ──
    # collect all data extents
    all_y = []
    for rho in [0.0, 1.0]:
        for N in N_vals:
            eta_m = 1.0/N
            all_y.append(sigma_per_B(eta_m, rho))
            all_y.append(sigma_per_B(1.0,  rho))
    for rho in rho_vals:
        all_y.append(sigma_per_B(eta_min_c, rho))
    y_lo = min(all_y) / 2.5
    y_hi = max(all_y) * 8.0
    for ax in axes:
        ax.set_ylim(y_lo, y_hi)

    fig.tight_layout(pad=1.5, w_pad=2.0)
    if save:
        outpath1 = os.path.join(OUTPUT_DIR, "fig_step3_averaging.pdf")
        outpath2 = os.path.join(OUTPUT_DIR, "fig_step3_averaging.png")
        fig.savefig(outpath1)
        fig.savefig(outpath2, dpi=200)
        print('✓  fig_step3_averaging saved')
    return fig


